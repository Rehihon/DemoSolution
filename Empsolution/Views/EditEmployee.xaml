<Window x:Class="Empsolution.Views.EditEmployee"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Empsolution.Views"
        xmlns:c="clr-namespace:Empsolution.ViewModels"
        mc:Ignorable="d"
        Title="Edit Employee" Height="600" Width="800">
    <Window.DataContext>
        <c:EditRecordsViewModel/>
    </Window.DataContext>
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height=" Auto"/>
            
        </Grid.RowDefinitions>

        <StackPanel Margin="50 50,20,40" Grid.Row="0"  >
            <TextBlock  HorizontalAlignment="Center" Text=" Edit Employee Details"  FontWeight="Bold"  FontSize="16"></TextBlock>

        </StackPanel>

        <Grid Grid.Row="1" Height="400" Margin="10"  Name="DeptRecord" DataContext="{Binding EditEmployee }">


          
                <Grid Grid.ColumnSpan="2" Margin="0,0,135,0">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <Grid.ColumnDefinitions >
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <TextBlock Grid.Row="0" Grid.Column="0" Margin="50,30,10,1"  Text=" Department" />
                    <TextBlock Grid.Row="1" Grid.Column="0" Margin="50,30,10,1"  Text=" Job " />
                    <TextBlock Grid.Row="2" Grid.Column="0" Margin="50,30,10,1"  Text="First Name " />
                    <TextBlock Grid.Row="3" Grid.Column="0" Margin="50,30,10,1"  Text="Surename " />
                    <TextBlock Grid.Row="4" Grid.Column="0" Margin="50,30,10,1"  Text="Date Of Birth "/>
                    <TextBlock Grid.Row="5" Grid.Column="0" Margin="50,30,10,1"  Text=" Start Date " />


              <ComboBox ItemsSource = "{Binding DataContext.Departments,
              RelativeSource={RelativeSource AncestorType=Window}}" Name="DepName"  HorizontalAlignment="Right"
              SelectedItem="{Binding DeparmentSelectedRecord}" 
              DisplayMemberPath="DepName"          
               Loaded="SetDepartmentCurrentId_event"         
               Margin="50,30,10,10"  Grid.Row="0" Grid.Column="1" Width="200" 
                        >

                    </ComboBox>

                    <ComboBox ItemsSource = "{Binding DataContext.Jobs, 
                 RelativeSource={RelativeSource AncestorType=Window}}" 
                 Grid.Row="1" Grid.Column="1"   DisplayMemberPath="Job_Title"
                  SelectedItem = "{Binding JobSelectedRecord}"
                  Loaded="SetCurrentJob_Event" 
                  SelectionChanged ="JobTitle_SelectionChanged"              
                  Height="25" Width="200" Name = "JobTitle" HorizontalAlignment="Right" 
                  Margin="50,30,10,1"            >
                    </ComboBox>


                <TextBox Grid.Row="2" Grid.Column="1" Margin="50,30,10,1"    Text="{Binding  FirstName}" Width="200" Name="firstName" />
                <TextBox Grid.Row="3" Grid.Column="1" Margin="50,30,10,1" Text="{Binding  Surename}" Width="200" Name="surename" />
                    <TextBox Grid.Row="4" Grid.Column="1" Margin="50,30,10,1" Text="{Binding  DOB}"  Width="200"  Name="dob"/>
                    <TextBox Grid.Row="5" Grid.Column="1" Margin="50,30,10,1" Text="{Binding  HireDate}"  Width="200" Name="startdate"/>
                </Grid>
          



        </Grid>


        <StackPanel Grid.Row="2" >
            <Button Width="100" Height="20" Content="Save Changes"  Click="SavedEditedEmployee_Click"></Button>
        </StackPanel>



    </Grid>
</Window>
