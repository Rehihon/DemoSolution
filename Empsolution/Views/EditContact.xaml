<Window x:Class="Empsolution.Views.EditContact"
           xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:local="clr-namespace:Empsolution.Views"
    xmlns:c="clr-namespace:Empsolution.ViewModels"
    mc:Ignorable="d"
    Title="Edit Contact" Height="600" Width="800">
    <Window.DataContext>
        <c:EditRecordsViewModel/>
    </Window.DataContext>
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height=" Auto"/>

        </Grid.RowDefinitions>

        <StackPanel Margin="50 50,20,40" Grid.Row="0"  >
            <TextBlock  HorizontalAlignment="Center" Text=" Edit Contact Details"  FontWeight="Bold"  FontSize="16"></TextBlock>

        </StackPanel>

        <Grid Grid.Row="1" Height="400" Margin="10"  Name="ContactRecord" DataContext="{Binding EditContact }">



            <Grid Grid.ColumnSpan="2" Margin="0,0,135,0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <Grid.ColumnDefinitions >
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <TextBlock Grid.Row="0" Grid.Column="0" Margin="50,30,10,1"  Text=" Mobile Number" />
                <TextBlock Grid.Row="1" Grid.Column="0" Margin="50,30,10,1"  Text=" Home Numbile" />
                <TextBlock Grid.Row="2" Grid.Column="0" Margin="50,30,10,1"  Text="Email" />
                <TextBlock Grid.Row="3" Grid.Column="0" Margin="50,30,10,1"  Text="Emegency Contact Name" />
                <TextBlock Grid.Row="4" Grid.Column="0" Margin="50,30,10,1"  Text="Emergency contact Phone Number" />
                <TextBlock Grid.Row="5" Grid.Column="0" Margin="50,30,10,1"  Text=" Description " />
                



                <TextBox Grid.Row="0" Grid.Column="1" Margin="50,30,10,1" Text="{Binding MobilPhoneNumber}" Width="200" Name="MobilePhoneNumber" />
                <TextBox Grid.Row="1" Grid.Column="1" Margin="50,30,10,1" Text="{Binding  HomephoneNumber}" Width="200" Name="HomePhoneNumber" />
                <TextBox Grid.Row="2" Grid.Column="1" Margin="50,30,10,1" Text="{Binding  Email}"  Width="200"  Name="Email"/>
                <TextBox Grid.Row="3" Grid.Column="1" Margin="50,30,10,1" Text="{Binding  EmergencyContactName}"  Width="200" Name="EmergencyContactName"/> 
                <TextBox Grid.Row="4" Grid.Column="1" Margin="50,30,10,1" Text="{Binding  EmergencyPhoneNumber}"  Width="200" Name="EmergencyPhoneNumber"/>
                <TextBox Grid.Row="5" Grid.Column="1" Margin="50,30,10,1" Text="{Binding  Description}"  Width="200" Name="Description"/>
            </Grid>




        </Grid>


        <StackPanel Grid.Row="2" >
            <Button Width="100" Height="20" Content="Save Changes"  Command="{Binding SaveContactCommand}"></Button>
        </StackPanel>



    </Grid>
</Window>
