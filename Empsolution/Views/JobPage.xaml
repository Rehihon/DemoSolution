<Page x:Class="Empsolution.Views.JobPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:Empsolution.Views"
      xmlns:vm="clr-namespace:Empsolution.ViewModels"
      mc:Ignorable="d" 
      d:DesignHeight="450" d:DesignWidth="800"
      Title="JobPage">
    <Page.DataContext>
        <vm:EmployeeViewModel/>
    </Page.DataContext>

    <Grid Height="600" Width="700">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <StackPanel  Grid.Row="0" Orientation="Vertical">
            <DataGrid  Margin="20" AutoGenerateColumns="False" ItemsSource="{Binding Jobs}" Height="Auto">
                <DataGrid.Columns>
                    
                    <DataGridTextColumn Header="Job Title" Binding="{Binding Job_Title}"/>
                    <DataGridTextColumn Header="Job Description" Binding="{Binding Description}"/>
                    <DataGridTextColumn Header="Minimum Salary" Binding="{Binding Max_Salary}"/>
                    <DataGridTextColumn Header="Maximum Salary" Binding="{Binding Max_Salary}" />
                </DataGrid.Columns>
            </DataGrid>
        </StackPanel>
        <StackPanel Grid.Row="1" Margin="20" Orientation="Horizontal" Height="60" Width="400">
            <Button Name="EditJob" Content="Add New Job" Height="20" Width="Auto" HorizontalAlignment="Left" Click="GoToNewJob_Click"/>
            <Button Name="Exit" Content="Close Page" Width="Auto" Height="Auto" Margin="20" HorizontalAlignment="Center"  Click="Exit_Click" />
        </StackPanel>
    </Grid>
</Page>
