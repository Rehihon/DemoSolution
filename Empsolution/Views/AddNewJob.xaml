<Page x:Class="Empsolution.Views.AddNewJob"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:Empsolution.Views"
       xmlns:vm="clr-namespace:Empsolution.ViewModels"
      mc:Ignorable="d" 
      d:DesignHeight="450" d:DesignWidth="800"
      Title="Add Job Details">

    <Page.DataContext>
        <vm:JobsViewModel/>
    </Page.DataContext>

    <Grid Height="600" Width="700">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <StackPanel  Grid.Row="0" Orientation="Vertical">
            <DataGrid  Margin="20" AutoGenerateColumns="False" ItemsSource="{Binding NewJobRecord}" Height="Auto"
                       SelectedItem="{Binding JobSelectedRecord}"
                       CanUserAddRows="True">
                <DataGrid.Resources>
                    <Style x:Key="GridColumnCellStyle" TargetType="TextBlock">
                        <Setter Property="Margin" Value="5"/>
                        <Setter Property="Width" Value="90"/>
                    </Style>
                </DataGrid.Resources>
                <DataGrid.Columns>
                    <DataGridTextColumn Header="Job Title" Binding="{Binding Job_Title }" ElementStyle="{StaticResource GridColumnCellStyle}"/>
                    <DataGridTextColumn Header="Job Description" Binding="{Binding Description, Mode=TwoWay}" ElementStyle="{StaticResource GridColumnCellStyle}"/>
                    <DataGridTextColumn Header="Minimum Salary" Binding="{Binding Max_Salary, Mode=TwoWay}" ElementStyle="{StaticResource GridColumnCellStyle}"/>
                    <DataGridTextColumn Header="Maximum Salary" Binding="{Binding Max_Salary,Mode=TwoWay}" ElementStyle="{StaticResource GridColumnCellStyle}"/>
                </DataGrid.Columns>
            </DataGrid>
        </StackPanel>
        <StackPanel Grid.Row="1" Margin="20" Orientation="Horizontal" Height="60" Width="400">
            <Button Name="SaveRecord" Content=" Save New Record " Height="40"  Margin="20,0,20,0" Width="Auto" Command ="{Binding SubmitJobCommand}" FontSize="20" HorizontalAlignment="Left"/>
            <Button Name="Exit" Content="   Exit   " Width="Auto" Height="40" Margin="20,0,10,0"  Click="Exit_Click" FontSize="20" HorizontalAlignment="Right"/>
        </StackPanel>
    </Grid>
</Page>
